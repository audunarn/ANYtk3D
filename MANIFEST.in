# Ship the tests in the source distribution so a packager can verify a build
# from the sdist alone.  Wheels are unaffected: they only carry src/anytk3d.
include LICENSE
include README.md
include RELEASE_NOTES.md
include THIRD_PARTY_NOTICES.md
include pyproject.toml
include run_gui.py
recursive-include tests *.py

prune build
prune dist
prune .idea
prune .pytest_cache
global-exclude *.py[cod]
global-exclude __pycache__
